# -----------------------------------------------------------------------------
# Server environment -- copy to server/.env and fill in. NEVER commit server/.env.
# -----------------------------------------------------------------------------
PORT=5000

# development | production. Production disables demo seeding and credential logs.
NODE_ENV=development

# REQUIRED. The server refuses to start without it (there is no in-source fallback).
# Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Local development only. Set to true to auto-seed demo users into an EMPTY database.
# MUST remain false/unset in production (production never seeds demo accounts).
SEED_DEMO_DATA=false

# Google Sign-In (CUSTOMER login only). The OAuth 2.0 *Web* client ID from your
# Google Cloud project. The server verifies Google ID tokens against this value
# (it is the token "audience"). This is a PUBLIC identifier, not a secret, but it
# lives server-side as the trusted verification value. Leave blank to disable
# Google sign-in. No Google client secret or service-account key is needed for
# ID-token verification, so none is stored here.
GOOGLE_WEB_CLIENT_ID=
