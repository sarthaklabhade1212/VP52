# Local development backend origin (Android emulator host-loopback alias).
# Loaded by `npm run dev` and by the Android emulator build `npm run build:dev`
# (vite --mode development). This file is intentionally TRACKED in git — it holds
# no secrets, only the shared local dev API URL. Production uses .env.production.
VITE_API_URL=http://10.0.2.2:5000

