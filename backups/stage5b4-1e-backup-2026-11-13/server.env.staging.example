# -----------------------------------------------------------------------------
# VP52 Staging Environment Configuration Template (server/.env.staging.example)
#
# Dedicated staging environment configuration.
# Copy to server/.env.staging (or export into staging environment).
# NEVER commit server/.env.staging or real credentials into version control.
# -----------------------------------------------------------------------------

PORT=5001
NODE_ENV=staging

# REQUIRED. Dedicated staging-only JWT secret. Must be distinct from production.
# Generate a random 48-byte hex secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=staging_jwt_secret_vp52_isolated_test_only_min64chars_abcdef0123456789

# Database path must be strictly isolated to staging database.
# Must NEVER point to /var/www/vp52 or canonical server/db/rewards.db.
DATABASE_PATH=./db/staging_rewards.db

# Upload directory must be isolated to staging uploads.
UPLOAD_DIR=./public/staging_uploads

# Auto-seeding disabled in staging (only synthetic staging test accounts created via migration).
SEED_DEMO_DATA=false

# Google Sign-In (optional staging test client ID; leave blank if testing password/synthetic auth)
GOOGLE_WEB_CLIENT_ID=

# SMS Provider for staging (mock delivery)
SMS_PROVIDER=mock

# -----------------------------------------------------------------------------
# Staging AdMob & SSV Configuration
# -----------------------------------------------------------------------------
# Staging uses Google test identifiers or a dedicated separate staging ad unit.
# Never point staging to production callback URLs.
ADMOB_APP_ID=ca-app-pub-4004834464698326~8764285486
# Separate Staging Rewarded Ad Unit (if provisioned in AdMob console) or default test unit:
ADMOB_REWARDED_AD_UNIT_ID=ca-app-pub-4004834464698326/8368553876
ADMOB_SSV_PENDING_TTL_SECONDS=900
ADMOB_SSV_CALLBACK_URL=https://staging.vp52coin.com/api/admob/ssv

# Staging HTTPS Enforcement
STAGING_ENFORCE_HTTPS=true
STAGING_HOST=127.0.0.1
