# -----------------------------------------------------------------------------
# Vite client environment variables (Rewardify)
#
# You normally do NOT need a base `.env` file. The API origin is resolved per mode:
#   * Development / Android emulator  -> client/.env.development   (tracked)
#       VITE_API_URL=http://10.0.2.2:5000
#   * Production build (`npm run build`) -> client/.env.production  (NOT committed)
#       copy client/.env.production.example and set your public HTTPS origin
#
# IMPORTANT: any VITE_API_URL set in a base `.env` also applies to production
# builds, so leave it unset here to avoid accidentally shipping a dev URL.
# -----------------------------------------------------------------------------
# VITE_API_URL=

# Google Sign-In (customer only). PUBLIC OAuth 2.0 *Web* client ID from Google
# Cloud. Safe to ship in the app bundle (it is not a secret). Must match the
# server's GOOGLE_WEB_CLIENT_ID. Set it in client/.env.development (for the
# Android emulator build) or client/.env.production (for release).
# VITE_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# VITE_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
