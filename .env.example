# NOTE: the server reads its config from server/.env (see server/.env.example).
# This root template is kept for convenience and mirrors those variables.
PORT=5000
NODE_ENV=development

# REQUIRED -- no in-source fallback. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Local development only; must be false/unset in production.
SEED_DEMO_DATA=false
