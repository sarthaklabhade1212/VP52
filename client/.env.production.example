gh auth logout# -----------------------------------------------------------------------------
# PRODUCTION client configuration -- copy to client/.env.production and edit.
#
# Must be your real, public, HTTPS API origin. The production build
# (`npm run build`) will REFUSE to build if this is missing, not https, or
# points at a development host (10.0.2.2 / localhost / 127.0.0.1).
#
# Do NOT commit the real client/.env.production.
# -----------------------------------------------------------------------------
VITE_API_URL=https://api.example.com

# Google Sign-In (customer only). PUBLIC Web OAuth client ID (not a secret).
# Must match the server's GOOGLE_WEB_CLIENT_ID. Leave unset to disable Google login.
# VITE_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# VITE_GOOGLE_IOS_CLIENT_ID=your-ios-client-id.apps.googleusercontent.com
